# Configuracion generica. Copiar a .env local; nunca publicar credenciales.
APP_NAME="ESPACIO-U"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/La_Paz
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=espacio_u
DB_USERNAME=
DB_PASSWORD=
DB_TIMEZONE=-04:00
# Solo para administrar la instancia local aislada; Laravel no usa esta clave.
MYSQL_DEV_ROOT_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
# Integraciones futuras: aun no implementadas.
IOT_TRANSPORT=
IOT_INGESTION_SECRET=
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=
BLOCKCHAIN_BASE_URL=
BLOCKCHAIN_API_KEY=
CHATBOT_BASE_URL=
CHATBOT_API_KEY=
GOOGLE_CLOUD_PROJECT=
