# Configuracion generica. Copiar a .env local; nunca publicar credenciales.
APP_NAME="ESPACIO-U"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/La_Paz
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=espacio_u
DB_USERNAME=
DB_PASSWORD=
DB_TIMEZONE=-04:00
# Solo para administrar la instancia local aislada; Laravel no usa esta clave.
MYSQL_DEV_ROOT_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
# Integraciones: completar solo las autorizadas; mantener secretos vacios aqui.
IOT_TRANSPORT=
IOT_INGESTION_SECRET=
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_DEPLOYMENT_BLOCK=0
BLOCKCHAIN_NODE_BINARY=node
CHATBOT_BASE_URL=
CHATBOT_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Administrador inicial: completar exclusivamente en .env local o usar comando interactivo
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# IoT: generar un secreto distinto de 32 bytes para cada entorno; nunca versionarlo.
IOT_MASTER_SECRET=
IOT_REQUEST_MAX_SKEW_SECONDS=300
IOT_MONITORING_FRESHNESS_SECONDS=300
IOT_RATE_LIMIT_PER_MINUTE=120
IOT_MAX_BODY_BYTES=4096
IOT_ORIGIN_RATE_LIMIT_PER_MINUTE=1200

# CU23: frecuencia técnica del scheduler, independiente de la tolerancia de cada política.
RELEASE_SCHEDULE="* * * * *"
RELEASE_BATCH_SIZE=100
