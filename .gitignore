# Secretos: conservar únicamente la plantilla pública revisada
.env
.env.*
!.env.example
/vendor/
/node_modules/
/storage/*.key
/storage/logs/*
/bootstrap/cache/*
*.pem
*.key
*.p12
*.pfx
service-account*.json
credentials*.json
secrets*.json
auth.json
.idea/
.vscode/
.DS_Store
Thumbs.db
# Material local y generado; nunca sustituye el historial Git
/work/
/public/build/
/public/hot
/public/storage
/storage/app/private/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/coverage/
/.phpunit.cache/
.phpunit.result.cache
*.log
*.sqlite
*.sqlite3
*.sql.gz
*.dump
*.bak
/compose.override.yaml
/docker-compose.override.yml
/.gcloud/
/.npmrc

# Herramientas y datos exclusivos de desarrollo local
/.tools/
/.local/

# Marcadores necesarios del skeleton Laravel; sin incluir contenido generado
!/bootstrap/cache/.gitignore
!/storage/logs/.gitignore
!/storage/app/private/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/cache/locks/
/storage/framework/cache/locks/*
!/storage/framework/cache/locks/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
/.phpactor.json
/.cursor/
/.nova/
/.zed/
/_ide_helper.php
/public/fonts-manifest.dev.json
/storage/pail/
